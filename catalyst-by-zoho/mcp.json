{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "catalyst": {
      "type": "streamable-http",
      "url": "https://zcatalyst.zohomcp.in/mcp/message",
      "http_headers": {
        "X-ZMCP-Client": "codex"
      },
      "extensions": {
        "com.openai": {
          "urlTemplates": [
            "https://zcatalyst.zohomcp.{dc}/mcp/message"
          ],
          "auth": {
            "type": "oauth"
          }
        }
      }
    }
  }
}
